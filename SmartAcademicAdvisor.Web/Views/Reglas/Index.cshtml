@model SmartAcademicAdvisor.Web.Crud.CrudIndexVm
@using SmartAcademicAdvisor.Web.Crud
@using System.Text.Json.Nodes
@using System.Globalization
@{
    ViewData["Title"] = "Motor de inferencia";
    var reglas = Model.Rows;
    var nombresEsp = ViewBag.Especialidades as Dictionary<string, string> ?? new();
    var inv = CultureInfo.InvariantCulture;

    int activas = reglas.Count(r => r["activa"]?.ToString().ToLowerInvariant() == "true");
    double pesoMedio = reglas.Any() ? reglas.Average(r => double.TryParse(r["peso"]?.ToString(), NumberStyles.Float, inv, out var pm) ? pm : 0) : 0;
    var predicados = reglas.SelectMany(r => (r["cuerpo"] as JsonArray)?.OfType<JsonObject>() ?? Enumerable.Empty<JsonObject>())
                           .Select(x => JsonFileStore.Str(x, "predicado")).Distinct().Count();
    var conclusiones = reglas.Select(r => JsonFileStore.Str(r["cabeza"] as JsonObject ?? new JsonObject(), "nombre")).Where(x => x != "").Distinct().Count();
    var destinos = reglas.Select(r => ReglaFormatter.Destino(r)).Where(x => x != "").Distinct().OrderBy(x => x).ToList();
}

<div class="page-header">
    <div class="header-content">
        <div>
            <h2 class="page-title-large">Motor de inferencia</h2>
            <p class="page-subtitle">Programación lógica con encadenamiento hacia adelante (forward chaining)</p>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Nueva regla</a>
    </div>
</div>

<div class="pipe">
    <div class="pipe-step" style="--c:#22D3EE"><small>1 · Hechos</small><b>@predicados</b><p>predicados sobre cada alumno: promedio, intereses y materias aprobadas</p></div>
    <div class="pipe-arrow"><i class="fas fa-long-arrow-alt-right"></i></div>
    <div class="pipe-step" style="--c:#8B5CF6"><small>2 · Reglas activas</small><b>@activas / @reglas.Count</b><p>se evalúan por prioridad y se dispara la que cumple todas sus premisas</p></div>
    <div class="pipe-arrow"><i class="fas fa-long-arrow-alt-right"></i></div>
    <div class="pipe-step" style="--c:#10B981"><small>3 · Conclusiones</small><b>@conclusiones</b><p>tipos de conclusión; el peso medio de confianza es @((pesoMedio * 100).ToString("0"))%</p></div>
</div>

<div class="toolbar">
    <div class="search"><i class="fas fa-search"></i><input id="q" class="form-control" placeholder="Buscar regla…" autocomplete="off" /></div>
    <div class="chips" id="chips">
        <button type="button" class="chip active" data-f="">Todas</button>
        <button type="button" class="chip" data-f="on">Activas</button>
        <button type="button" class="chip" data-f="off">Inactivas</button>
        @foreach (var d in destinos) { <button type="button" class="chip" data-f="@d">@(nombresEsp.TryGetValue(d, out var n) ? n : d)</button> }
    </div>
</div>

@if (!reglas.Any())
{
    <div class="chart-card text-center py-5"><i class="fas fa-cogs fa-3x text-muted mb-3"></i><p class="text-muted mb-0">No hay reglas configuradas</p></div>
}
<div class="rules-grid" id="reglas">
    @foreach (var r in reglas)
    {
        var id = JsonFileStore.Str(r, "id");
        var on = r["activa"]?.ToString().ToLowerInvariant() == "true";
        double.TryParse(r["peso"]?.ToString(), NumberStyles.Float, inv, out var peso);
        var cabeza = r["cabeza"] as JsonObject ?? new JsonObject();
        var cuerpo = (r["cuerpo"] as JsonArray)?.OfType<JsonObject>().ToList() ?? new List<JsonObject>();
        var dest = ReglaFormatter.Destino(r);
        <article class="rule-card @(on ? "" : "off")" data-txt="@((id + " " + JsonFileStore.Str(r, "nombre")).ToLowerInvariant())" data-on="@(on ? "on" : "off")" data-d="@dest">
            <div class="rule-head">
                <div><span class="rule-id">@id</span><h5 class="mt-2">@JsonFileStore.Str(r, "nombre")</h5></div>
                <span class="status-badge @(on ? "success" : "")">@(on ? "Activa" : "Inactiva")</span>
            </div>
<pre class="code">@Html.Raw(ReglaFormatter.Codigo(cabeza, cuerpo))</pre>
            <div class="rule-foot">
                <div class="rule-desc">@JsonFileStore.Str(r, "descripcion")</div>
                <div class="meter"><div class="t"><span>peso</span><span>@((peso * 100).ToString("0"))%</span></div><div class="b"><i style="width:@((peso * 100).ToString("0", inv))%"></i></div></div>
                <div class="btn-group">
                    <a asp-action="Edit" asp-route-id="@id" class="btn btn-sm btn-warning" title="Editar"><i class="fas fa-edit"></i></a>
                    <a asp-action="Delete" asp-route-id="@id" class="btn btn-sm btn-danger" title="Eliminar"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </article>
    }
</div>

@section Scripts {
<script>
    const cards = [...document.querySelectorAll('.rule-card')]; let f = '', q = '';
    function aplicar() { cards.forEach(c => { const okF = f === '' || (f === 'on' || f === 'off' ? c.dataset.on === f : c.dataset.d === f);
        c.style.display = okF && c.dataset.txt.includes(q) ? '' : 'none'; }); }
    document.getElementById('q').addEventListener('input', e => { q = e.target.value.toLowerCase().trim(); aplicar(); });
    document.getElementById('chips').addEventListener('click', e => { const b = e.target.closest('.chip'); if (!b) return;
        document.querySelectorAll('#chips .chip').forEach(c => c.classList.toggle('active', c === b)); f = b.dataset.f; aplicar(); });
</script>
}

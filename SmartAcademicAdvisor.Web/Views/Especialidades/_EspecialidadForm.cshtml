@model SmartAcademicAdvisor.Web.Models.EspecialidadFormModel
@using SmartAcademicAdvisor.Web.Crud
@{
    var materias = (ViewBag.MateriasOpciones as List<Opt>) ?? new List<Opt>();
    var sel = Model?.MateriasClaveIds ?? Array.Empty<string>();
    var intsSel = Model?.InteresesSeleccionados ?? Array.Empty<string>();
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="form-layout">
    <div>
        <section class="form-sec">
            <div class="form-sec-h"><span class="n">1</span><div><h5>Identidad</h5><small>Qué es y a qué se dedica esta especialidad</small></div></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <div class="field"><input asp-for="Nombre" id="f-nombre" class="form-control" placeholder="Ej: Ciencia de Datos" /><i class="fas fa-graduation-cap"></i></div>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <div class="field area"><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><i class="fas fa-align-left"></i></div>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="CampoLaboral" class="form-label">Campo laboral</label>
                <div class="field"><input asp-for="CampoLaboral" class="form-control" placeholder="Ej: Científico de Datos, Analista de Datos" /><i class="fas fa-briefcase"></i></div>
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec-h"><span class="n">2</span><div><h5>Requisitos</h5><small>Promedio mínimo y competencias</small></div></div>
            <label asp-for="PromedioMinimo" class="form-label">Promedio mínimo (0 a 100)</label>
            <div class="range-row mb-1">
                <input type="range" id="f-min-r" min="0" max="100" step="0.5" value="@(Model != null && Model.PromedioMinimo > 0 ? Model.PromedioMinimo.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "80")" />
                <input asp-for="PromedioMinimo" id="f-min" type="number" class="form-control" min="0" max="100" step="0.1" />
            </div>
            <span asp-validation-for="PromedioMinimo" class="text-danger d-block mb-3"></span>
            <label asp-for="CompetenciasRequeridas" class="form-label">Competencias requeridas</label>
            <div class="field"><input asp-for="CompetenciasRequeridas" class="form-control" placeholder="Separadas por coma: Python, Estadística, SQL" /><i class="fas fa-list-check"></i></div>
        </section>

        <section class="form-sec">
            <div class="form-sec-h"><span class="n">3</span><div><h5>Perfil de afinidad</h5><small>Intereses y materias que definen a esta especialidad</small></div></div>
            <label class="form-label">Intereses clave</label>
            <div class="pill-grid mb-3">
                @foreach (var interes in SmartAcademicAdvisor.Web.Models.AlumnoFormModel.InteresesDisponibles)
                {
                    <label class="pill"><input type="checkbox" name="InteresesSeleccionados" value="@interes" checked="@intsSel.Contains(interes)" /><span>@interes</span></label>
                }
            </div>
            <label class="form-label">Materias clave</label>
            <div class="pill-grid">
                @foreach (var m in materias)
                {
                    <label class="pill"><input type="checkbox" name="MateriasClaveIds" value="@m.Value" checked="@sel.Contains(m.Value)" /><span>@m.Label</span></label>
                }
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec-h"><span class="n">4</span><div><h5>Pesos de afinidad</h5><small>Cuánto pesa cada factor al calcular la afinidad (deben sumar 1.00)</small></div></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="PesoPromedio" class="form-label"><i class="fas fa-circle" style="color:#10B981;font-size:9px"></i> Promedio</label><div class="range-row"><input type="range" class="pr" min="0" max="1" step="0.01" /><input asp-for="PesoPromedio" type="number" class="form-control peso" min="0" max="1" step="0.01" /></div></div>
                <div class="col-md-6"><label asp-for="PesoIntereses" class="form-label"><i class="fas fa-circle" style="color:#8B5CF6;font-size:9px"></i> Intereses</label><div class="range-row"><input type="range" class="pr" min="0" max="1" step="0.01" /><input asp-for="PesoIntereses" type="number" class="form-control peso" min="0" max="1" step="0.01" /></div></div>
                <div class="col-md-6"><label asp-for="PesoMateriasClave" class="form-label"><i class="fas fa-circle" style="color:#F97316;font-size:9px"></i> Materias clave</label><div class="range-row"><input type="range" class="pr" min="0" max="1" step="0.01" /><input asp-for="PesoMateriasClave" type="number" class="form-control peso" min="0" max="1" step="0.01" /></div></div>
                <div class="col-md-6"><label asp-for="PesoReglas" class="form-label"><i class="fas fa-circle" style="color:#22D3EE;font-size:9px"></i> Reglas</label><div class="range-row"><input type="range" class="pr" min="0" max="1" step="0.01" /><input asp-for="PesoReglas" type="number" class="form-control peso" min="0" max="1" step="0.01" /></div></div>
            </div>
            <p class="mt-3 mb-0 text-muted">Suma de pesos: <span id="sumaPesos" class="status-badge">1.00</span> debe ser 1.00</p>
        </section>
    </div>

    <aside class="live">
        <div class="live-label"><i class="fas fa-eye"></i> Vista previa en vivo</div>
        <article class="chart-card text-center">
            <div class="donut" id="donut"><b id="donut-t">1.00</b></div>
            <h5 id="pv-nombre" class="mb-1">Nombre de la especialidad</h5>
            <p class="text-muted small mb-3">Promedio mínimo <b id="pv-min">80</b></p>
            <div class="legend-w">
                <span><i style="background:#10B981"></i>Promedio <b id="w0"></b></span><span><i style="background:#8B5CF6"></i>Intereses <b id="w1"></b></span>
                <span><i style="background:#F97316"></i>Materias <b id="w2"></b></span><span><i style="background:#22D3EE"></i>Reglas <b id="w3"></b></span>
            </div>
        </article>
        <div class="tip mt-3"><i class="fas fa-lightbulb"></i> Estos pesos los usa el asesor del alumno para explicar por qué recomienda cada especialidad.</div>
    </aside>
</div>

<script>
(function () {
    const $ = id => document.getElementById(id);
    const nums = [...document.querySelectorAll('.peso')], rngs = [...document.querySelectorAll('.pr')];
    const colores = ['#10B981', '#8B5CF6', '#F97316', '#22D3EE'];
    const min = $('f-min'), minR = $('f-min-r');
    minR.addEventListener('input', () => { min.value = minR.value; render(); });
    min.addEventListener('input', () => { if (min.value !== '') minR.value = min.value; });
    nums.forEach((n, i) => {
        rngs[i].value = n.value || 0;
        rngs[i].addEventListener('input', () => { n.value = parseFloat(rngs[i].value).toFixed(2); render(); });
        n.addEventListener('input', () => { rngs[i].value = n.value || 0; });
    });
    function render() {
        const v = nums.map(n => parseFloat(n.value) || 0), t = v.reduce((a, b) => a + b, 0);
        const suma = $('sumaPesos'); suma.textContent = t.toFixed(2); suma.className = 'status-badge ' + (Math.abs(t - 1) < 0.005 ? 'success' : 'warning');
        let acc = 0; const stops = v.map((x, i) => { const a = acc; acc += t ? x / t * 100 : 0; return colores[i] + ' ' + a + '% ' + acc + '%'; });
        $('donut').style.background = t ? 'conic-gradient(' + stops.join(',') + ')' : '#E5E7EB';
        $('donut-t').textContent = t.toFixed(2);
        v.forEach((x, i) => { $('w' + i).textContent = Math.round(t ? x / t * 100 : 0) + '%'; });
        $('pv-nombre').textContent = $('f-nombre').value.trim() || 'Nombre de la especialidad';
        $('pv-min').textContent = min.value || '–';
    }
    document.querySelectorAll('.form-layout input').forEach(i => i.addEventListener('input', render));
    render();
})();
</script>

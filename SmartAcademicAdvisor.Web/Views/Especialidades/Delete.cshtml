@model SmartAcademicAdvisor.Core.Models.Especialidad
@{
    ViewData["Title"] = "Eliminar especialidad";
}

<div class="page-header">
    <div class="header-content">
        <div>
            <h2 class="page-title-large">Eliminar especialidad</h2>
            <p class="page-subtitle">Esta acción no se puede deshacer</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Cancelar</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="chart-card">
            <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>
                <span>Vas a eliminar <strong>@Model.Nombre</strong> (<code>@Model.Id</code>). Las reglas y recomendaciones que la mencionen dejarán de coincidir.</span></div>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

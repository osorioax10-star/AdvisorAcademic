@model SmartAcademicAdvisor.Core.Models.Alumno
@{
    ViewData["Title"] = "Detalles del alumno";
    var iniciales = string.Concat(Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var claseProm = Model.Promedio >= 90 ? "success" : Model.Promedio >= 70 ? "info" : "warning";
}

<div class="page-header">
    <div class="header-content">
        <div>
            <h2 class="page-title-large">Detalles del alumno</h2>
            <p class="page-subtitle">Información completa del estudiante</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> Editar</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="student-header mb-4">
                <div class="avatar-initials">@iniciales</div>
                <div class="flex-grow-1">
                    <h3 class="mb-1">@Model.Nombre</h3>
                    <p class="text-muted mb-1"><i class="fas fa-envelope"></i> @Model.Correo</p>
                    <p class="text-muted mb-0"><i class="fas fa-id-card"></i> <code>@Model.Id</code></p>
                </div>
                <span class="status-badge @(Model.Estatus == SmartAcademicAdvisor.Core.Models.EstatusAlumno.Activo ? "success" : "")">@Model.Estatus</span>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-4 mb-3"><small class="text-muted d-block">Semestre</small><span class="fs-5">Semestre @Model.Semestre</span></div>
                <div class="col-md-4 mb-3"><small class="text-muted d-block">Promedio</small><span class="status-badge @claseProm fs-6">@Model.Promedio.ToString("F1")</span></div>
                <div class="col-md-4 mb-3"><small class="text-muted d-block">Registro</small>@Model.FechaRegistro.ToString("dd/MM/yyyy")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.EspecialidadRecomendada))
            {
                <div class="mb-3"><small class="text-muted d-block">Especialidad recomendada</small>
                    <span class="status-badge success fs-6">@Model.EspecialidadRecomendada</span></div>
            }
            <div>
                <small class="text-muted d-block mb-1">Intereses</small>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var i in Model.Intereses) { <span class="tag">@i</span> }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="chart-card mb-4">
            <h6 class="mb-3">Resumen</h6>
            <div class="stat-item"><span class="stat-label">Promedio</span><span class="stat-value">@Model.Promedio.ToString("F1")</span></div>
            <div class="stat-item"><span class="stat-label">Semestre</span><span class="stat-value">@Model.Semestre</span></div>
            <div class="stat-item"><span class="stat-label">Intereses</span><span class="stat-value">@Model.Intereses.Count</span></div>
        </div>
        <div class="chart-card">
            <h6 class="mb-3">Acciones</h6>
            <div class="d-grid gap-2">
                <a asp-controller="Recomendaciones" asp-action="PorAlumno" asp-route-matricula="@Model.Id" class="btn btn-primary"><i class="fas fa-lightbulb"></i> Ver recomendaciones</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i> Eliminar alumno</a>
            </div>
        </div>
    </div>
</div>
